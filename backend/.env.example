# Copy this file to .env and fill in your real values.
# Nothing here is required for the default local mode — FormFill fills forms
# with no API key at all. The AI_* values only matter if FILL_MODE=ai.

# "local" = on-device extraction + semantic matching, no network, no key.
# "ai"    = send fields to an OpenAI-compatible endpoint (needs AI_API_KEY).
FILL_MODE=local

# One profile per install; v0 has no auth.
PROFILE_ID=default

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

DATA_DIR=../data
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=50
