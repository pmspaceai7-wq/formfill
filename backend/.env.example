# ==============================================================================
# InstaFill API Configuration (.env)
# ==============================================================================

# Server & Data Storage
HOST=127.0.0.1
PORT=8001
DATA_DIR=../data
FRONTEND_ORIGIN=http://localhost:3000

# Fill Mode: 'local' (built-in regex/keyword matcher) or 'ai' (LLM completions)
FILL_MODE=local

# AI LLM Provider Configuration (Required only when FILL_MODE=ai)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=your_api_key_here
AI_MODEL=qwen/qwen3.8-27b
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60.0
AI_BATCH_SIZE=40
AI_CONCURRENCY=3
