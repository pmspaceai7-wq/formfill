# ==============================================================================
# InstaFill API Configuration (.env)
# ==============================================================================

# Server & Data Storage
HOST=127.0.0.1
PORT=8001
DATA_DIR=../data
FRONTEND_ORIGIN=http://localhost:3000

# Fill Mode: 'local' (built-in regex/keyword matcher) or 'ai' (LLM completions)
FILL_MODE=local

# AI LLM Provider Configuration (Required only when FILL_MODE=ai)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=your_api_key_here
AI_MODEL=qwen/qwen3.8-27b
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60.0
AI_BATCH_SIZE=40
AI_CONCURRENCY=3

# ==============================================================================
# MongoDB
# ==============================================================================
MONGODB_URI= mongodb+srv://new:123@cluster0.oxv3v.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=formfill

# ==============================================================================
# JWT — generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
# ==============================================================================
JWT_SECRET_KEY=spaceaiappformfill975321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Single admin account — created/synced from these values on every startup.
# There is no public sign-up form; only the admin can create other users
# (see POST /api/admin/users), and only from a business email address.
# ==============================================================================
ADMIN_EMAIL=support@spacelizit.com
ADMIN_PASSWORD=spacelizit@321
ADMIN_NAME=Administrator

# Comma-separated list of email domains that are NOT allowed for user
# accounts (personal/free providers). Leave the default unless you have a
# specific reason to change it.
# BLOCKED_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com,aol.com
